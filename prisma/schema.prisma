generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  /// Login handle, stored lowercase. Friend code is `username#friendTag`.
  username        String    @unique
  friendTag       String
  displayName     String
  avatarUrl       String?
  email           String?   @unique
  emailVerifiedAt DateTime?
  /// Null for accounts created through Steam that never set a password.
  passwordHash    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  authTokens AuthToken[]

  friendshipsA      Friendship[]       @relation("FriendshipA")
  friendshipsB      Friendship[]       @relation("FriendshipB")
  sentRequests      FriendRequest[]    @relation("SentRequests")
  receivedRequests  FriendRequest[]    @relation("ReceivedRequests")
  inviteLinks       InviteLink[]
  inviteRedemptions InviteRedemption[]

  ownedGroups        Group[]            @relation("OwnedGroups")
  groupMemberships   GroupMember[]
  groupJoinRequests  GroupJoinRequest[] @relation("JoinRequestUser")
  groupInvitesSent   GroupJoinRequest[] @relation("JoinRequestInviter")
  groupDecisionsMade GroupJoinRequest[] @relation("JoinRequestDecider")
  chatMessages       ChatMessage[]
  gamesAdded         GroupGame[]
  playSessions       PlaySession[]
  voteRoundsStarted  VoteRound[]        @relation("VoteRoundStarter")
  voteRoundsEnded    VoteRound[]        @relation("VoteRoundEnder")
  voteCandidates     VoteCandidate[]
  voteBallots        VoteBallot[]
  voteEvents         VoteEvent[]
  votePrompts        VotePrompt[]

  notificationPreferences NotificationPreference[]
  notifications           Notification[]
}

model Group {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  ownerId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Dissolved groups are archived (history kept), hidden from members.
  dissolvedAt DateTime?

  owner        User               @relation("OwnedGroups", fields: [ownerId], references: [id])
  members      GroupMember[]
  joinRequests GroupJoinRequest[]
  messages     ChatMessage[]
  games        GroupGame[]
  voteRounds   VoteRound[]

  @@index([ownerId])
}

model GroupMember {
  groupId    String
  userId     String
  joinedAt   DateTime @default(now())
  /// Chat messages after this are unread for the member.
  lastReadAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A member invited a friend; the owner must approve. Kept as membership history.
model GroupJoinRequest {
  id          String            @id @default(cuid())
  groupId     String
  userId      String
  invitedById String
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  decidedAt   DateTime?
  decidedById String?

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User  @relation("JoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("JoinRequestInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  decidedBy User? @relation("JoinRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([groupId, status])
  @@index([userId])
}

/// Undirected friendship, stored once with userAId < userBId.
model Friendship {
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  /// How it was formed: "request", "invite".
  source    String

  userA User @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@id([userAId, userBId])
  @@index([userBId])
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// One row per direction; re-sending after a decline reuses the row.
model FriendRequest {
  id          String              @id @default(cuid())
  fromId      String
  toId        String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  from User @relation("SentRequests", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("ReceivedRequests", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId, status])
}

model InviteLink {
  id        String    @id @default(cuid())
  code      String    @unique
  creatorId String
  /// Null = never expires.
  expiresAt DateTime?
  /// Null = unlimited.
  maxUses   Int?
  uses      Int       @default(0)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  creator     User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  redemptions InviteRedemption[]

  @@index([creatorId])
}

model InviteRedemption {
  inviteId  String
  userId    String
  createdAt DateTime @default(now())

  invite InviteLink @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([inviteId, userId])
}

/// External identity linked to a user (Steam, Discord).
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  displayName       String?
  avatarUrl         String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model Session {
  /// SHA-256 of the session token; the raw token only lives in the cookie.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

enum ChatMessageType {
  USER
  /// Generated by the app (member joined, group renamed, vote started, ...).
  SYSTEM
}

/// Group chat. Kept forever so members can scroll back through the whole history.
model ChatMessage {
  id        String          @id @default(cuid())
  groupId   String
  /// Null for system messages.
  authorId  String?
  type      ChatMessageType @default(USER)
  body      String
  createdAt DateTime        @default(now())

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
}

enum GameSource {
  STEAM
  IGDB
  MANUAL
}

/// Game metadata. Steam / IGDB games are shared by every group (one row per
/// external id); manual games are created by, and only listed in, one group.
model Game {
  id                String     @id @default(cuid())
  source            GameSource
  /// Steam appid / IGDB id. Null for manual games.
  externalId        String?
  name              String
  coverUrl          String?
  description       String     @default("")
  genres            String[]
  /// Ways to play together: Steam categories / IGDB game modes (多人, 在线合作, ...).
  features          String[]
  /// Platforms or launchers (Windows, EA App, ...).
  platforms         String[]
  developers        String[]
  releaseDate       String?
  screenshots       String[]
  storeUrl          String?
  isFree            Boolean    @default(false)
  /// Prices in the currency's smallest unit.
  priceFinal        Int?
  priceInitial      Int?
  priceCurrency     String?
  discountPercent   Int?
  /// Steam: share of positive user reviews; IGDB: rating. 0-100.
  reviewPercent     Int?
  reviewCount       Int?
  /// Localized verdict, e.g. 特别好评.
  reviewLabel       String?
  metacritic        Int?
  metadataUpdatedAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  groupGames   GroupGame[]
  playSessions PlaySession[]
  wonRounds    VoteRound[]     @relation("VoteRoundWinner")
  candidacies  VoteCandidate[]
  voteBallots  VoteBallot[]
  voteEvents   VoteEvent[]
  votePrompts  VotePrompt[]

  @@unique([source, externalId])
  @@index([source, metadataUpdatedAt])
}

/// A game in a group's library.
model GroupGame {
  groupId   String
  gameId    String
  addedById String?
  addedAt   DateTime @default(now())

  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  game    Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  addedBy User? @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@id([groupId, gameId])
  @@index([gameId])
}

enum PlaySource {
  STEAM
  DISCORD
  MANUAL
}

/// One person playing one game. Open while endedAt is null; lastSeenAt is the
/// last time the source confirmed it, and becomes endedAt when it stops.
/// "Played together" is derived from overlapping sessions, not stored.
model PlaySession {
  id         String     @id @default(cuid())
  userId     String
  gameId     String
  source     PlaySource
  startedAt  DateTime
  lastSeenAt DateTime
  endedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([userId, endedAt])
  @@index([gameId, startedAt])
  @@index([source, endedAt])
}

enum VoteRoundStatus {
  OPEN
  ENDED
}

enum VoteEndReason {
  /**
   * A member ended it.
   */
  MANUAL
  /**
   * A member ended it and started the next round.
   */
  NEXT_ROUND
  /**
   * Its deadline passed.
   */
  DEADLINE
  /**
   * Ended from a "you're playing it together" prompt (#10).
   */
  PROMPT
}

/// One round of "what do we play next". At most one OPEN round per group
/// (partial unique index in the migration). Never deleted.
model VoteRound {
  id           String          @id @default(cuid())
  groupId      String
  /// 1, 2, 3... within the group.
  number       Int
  title        String          @default("")
  maxVotes     Int             @default(3)
  status       VoteRoundStatus @default(OPEN)
  startedById  String?
  startedAt    DateTime        @default(now())
  deadline     DateTime?
  endedAt      DateTime?
  endedById    String?
  endReason    VoteEndReason?
  winnerGameId String?
  /// The round this one continued from ("end and start next").
  previousId   String?

  group      Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  startedBy  User?           @relation("VoteRoundStarter", fields: [startedById], references: [id], onDelete: SetNull)
  endedBy    User?           @relation("VoteRoundEnder", fields: [endedById], references: [id], onDelete: SetNull)
  winner     Game?           @relation("VoteRoundWinner", fields: [winnerGameId], references: [id], onDelete: SetNull)
  previous   VoteRound?      @relation("VoteRoundChain", fields: [previousId], references: [id], onDelete: SetNull)
  next       VoteRound[]     @relation("VoteRoundChain")
  candidates VoteCandidate[]
  ballots    VoteBallot[]
  events     VoteEvent[]
  prompts    VotePrompt[]

  @@unique([groupId, number])
  @@index([groupId, status])
}

model VoteCandidate {
  roundId   String
  gameId    String
  addedById String?
  addedAt   DateTime @default(now())

  round   VoteRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  game    Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  addedBy User?     @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@id([roundId, gameId])
}

/// Current votes: one row per (round, voter, game).
model VoteBallot {
  roundId String
  userId  String
  gameId  String
  castAt  DateTime @default(now())

  round VoteRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  game  Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@id([roundId, userId, gameId])
  @@index([roundId, gameId])
}

enum VoteEventKind {
  CANDIDATE
  CAST
  RETRACT
  /// A candidate nobody voted for was taken off the list.
  REMOVED
}

/// Append-only log of everything that happened in a round, for replay.
model VoteEvent {
  id      String        @id @default(cuid())
  roundId String
  userId  String?
  gameId  String
  kind    VoteEventKind
  at      DateTime      @default(now())

  round VoteRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user  User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  game  Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([roundId, at])
}

enum VotePromptStatus {
  PENDING
  /**
   * A member chose to keep the vote going.
   */
  CONTINUED
  /**
   * A member ended the vote and started the next round.
   */
  ENDED_NEXT
  /**
   * A member just ended the vote.
   */
  ENDED
  /**
   * The round ended some other way first.
   */
  EXPIRED
}

/// "More than half of you have been playing X together for 20+ minutes and it
/// ranks top 2: end the vote?" Kept as history, one row per prompt.
model VotePrompt {
  id           String           @id @default(cuid())
  roundId      String
  gameId       String
  /// Players and group size when it was raised.
  players      Int
  memberCount  Int
  rank         Int
  /// Start of the play session that triggered it (a later session may prompt again).
  playingSince DateTime
  status       VotePromptStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  round      VoteRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  game       Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  resolvedBy User?     @relation(fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([roundId, status])
}

enum NotificationEvent {
  /// A vote round started in one of your groups.
  NEW_ROUND
  /// "You're playing a front-runner together: end the vote?" (#10)
  VOTE_PROMPT
  /// A member asked to bring someone into a group you own.
  JOIN_REQUEST
  /// Someone sent you a friend request.
  FRIEND_REQUEST
}

enum NotificationChannel {
  EMAIL
  DISCORD
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

/// A user's choice for one event on one channel. Missing rows use the defaults in
/// src/lib/notify/rules.ts.
model NotificationPreference {
  userId  String
  event   NotificationEvent
  channel NotificationChannel
  enabled Boolean

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, event, channel])
}

/// Every notification, kept as history. Also the send queue: the worker picks up
/// due PENDING rows and retries failures with backoff.
model Notification {
  id            String              @id @default(cuid())
  userId        String
  event         NotificationEvent
  channel       NotificationChannel
  title         String
  body          String
  /// Absolute link to the page the notification is about.
  url           String
  status        NotificationStatus  @default(PENDING)
  attempts      Int                 @default(0)
  /// When PENDING: next try. When SENDING: when the current try started.
  nextAttemptAt DateTime            @default(now())
  lastError     String?
  createdAt     DateTime            @default(now())
  sentAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
}
