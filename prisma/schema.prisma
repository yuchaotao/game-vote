generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  /// Login handle, stored lowercase. Friend code is `username#friendTag`.
  username        String    @unique
  friendTag       String
  displayName     String
  avatarUrl       String?
  email           String?   @unique
  emailVerifiedAt DateTime?
  /// Null for accounts created through Steam that never set a password.
  passwordHash    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  authTokens AuthToken[]

  friendshipsA      Friendship[]       @relation("FriendshipA")
  friendshipsB      Friendship[]       @relation("FriendshipB")
  sentRequests      FriendRequest[]    @relation("SentRequests")
  receivedRequests  FriendRequest[]    @relation("ReceivedRequests")
  inviteLinks       InviteLink[]
  inviteRedemptions InviteRedemption[]

  ownedGroups        Group[]            @relation("OwnedGroups")
  groupMemberships   GroupMember[]
  groupJoinRequests  GroupJoinRequest[] @relation("JoinRequestUser")
  groupInvitesSent   GroupJoinRequest[] @relation("JoinRequestInviter")
  groupDecisionsMade GroupJoinRequest[] @relation("JoinRequestDecider")
}

model Group {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  ownerId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Dissolved groups are archived (history kept), hidden from members.
  dissolvedAt DateTime?

  owner        User               @relation("OwnedGroups", fields: [ownerId], references: [id])
  members      GroupMember[]
  joinRequests GroupJoinRequest[]

  @@index([ownerId])
}

model GroupMember {
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A member invited a friend; the owner must approve. Kept as membership history.
model GroupJoinRequest {
  id          String            @id @default(cuid())
  groupId     String
  userId      String
  invitedById String
  status      JoinRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  decidedAt   DateTime?
  decidedById String?

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User  @relation("JoinRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("JoinRequestInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  decidedBy User? @relation("JoinRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([groupId, status])
  @@index([userId])
}

/// Undirected friendship, stored once with userAId < userBId.
model Friendship {
  userAId   String
  userBId   String
  createdAt DateTime @default(now())
  /// How it was formed: "request", "invite".
  source    String

  userA User @relation("FriendshipA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipB", fields: [userBId], references: [id], onDelete: Cascade)

  @@id([userAId, userBId])
  @@index([userBId])
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// One row per direction; re-sending after a decline reuses the row.
model FriendRequest {
  id          String              @id @default(cuid())
  fromId      String
  toId        String
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  from User @relation("SentRequests", fields: [fromId], references: [id], onDelete: Cascade)
  to   User @relation("ReceivedRequests", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId, status])
}

model InviteLink {
  id        String    @id @default(cuid())
  code      String    @unique
  creatorId String
  /// Null = never expires.
  expiresAt DateTime?
  /// Null = unlimited.
  maxUses   Int?
  uses      Int       @default(0)
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  creator     User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  redemptions InviteRedemption[]

  @@index([creatorId])
}

model InviteRedemption {
  inviteId  String
  userId    String
  createdAt DateTime @default(now())

  invite InviteLink @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([inviteId, userId])
}

/// External identity linked to a user (Steam, Discord).
model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  displayName       String?
  avatarUrl         String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
}

model Session {
  /// SHA-256 of the session token; the raw token only lives in the cookie.
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}
