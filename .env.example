# Copy to .env and fill in. Never commit .env.

APP_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Local development (docker compose postgres/redis on localhost).
# In the "app" compose profile these are overridden to point at the compose services.
DATABASE_URL=postgresql://gamevote:gamevote@localhost:5432/gamevote
REDIS_URL=redis://localhost:6379
POSTGRES_USER=gamevote
POSTGRES_PASSWORD=gamevote
POSTGRES_DB=gamevote

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Discord application: https://discord.com/developers/applications
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Outgoing mail. Leave SMTP_HOST empty to print emails to the server log.
# Local dev: run Mailpit (docker compose --profile dev up -d) and use
#   SMTP_HOST=localhost SMTP_PORT=1025 — view mail at http://<host>:8025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# IGDB (Twitch developer app): https://dev.twitch.tv/console/apps
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional dedicated Steam account used to send Steam chat notifications
STEAM_BOT_USERNAME=
STEAM_BOT_PASSWORD=
